{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md", "CONVENTIONS.md"],
  "mcp": {
    "bigpowers": {
      "type": "local",
      "command": ["node", "scripts/mcp-server.js"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    }
  },
  "lsp": {
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh"]
    },
    "markdownlint": {
      "command": ["markdownlint-cli2", "--no-globs", "--"],
      "extensions": [".md"]
    }
  }
}
